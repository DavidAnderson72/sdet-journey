{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Rate",
  "type": "object",
  "required": ["date", "base", "quote", "rate"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "base": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "quote": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
    }
  }
}
